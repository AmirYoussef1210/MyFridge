<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Units"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_settings_units"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_settings_metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="metric"
                android:textColor="?attr/colorOnSurface"
                android:text="Metric (kg / ml)" />

            <RadioButton
                android:id="@+id/rb_settings_imperial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="imperial"
                android:textColor="?attr/colorOnSurface"
                android:text="Imperial (lb / oz)" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Notify me X days before expiration"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_settings_days_before_expire"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="1–30"
            android:inputType="number"
            android:padding="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="@color/text_gray" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_expiry_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Expiry alerts (notification)"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_settings_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D32F2F"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Save"
            android:textAllCaps="false"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Logout"
            app:backgroundTint="#D32F2F"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
