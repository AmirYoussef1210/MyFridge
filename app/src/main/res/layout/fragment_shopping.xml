<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shopping list"
        android:textColor="#1A1C1E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_shopping_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Product name"
        android:inputType="text"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/et_shopping_how_many"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Qty"
        android:inputType="number"
        android:minHeight="48dp" />

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cb_keep_when_bought"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Keep this item after bought" />

    <Button
        android:id="@+id/btn_shopping_defaults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Pick from default fridge items"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btn_shopping_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Add to my list"
        android:textAllCaps="false"
        app:backgroundTint="#135BEC" />

    <TextView
        android:id="@+id/tv_shopping_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Your shopping list is empty."
        android:textColor="#7C86A1"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_shopping"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />

</LinearLayout>

